                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    ROW_NUMBER() OVER (ORDER BY Fecha) AS Id_Tiempo,
    Fecha,
    Fecha AS Fecha_Pedido,
    Fecha AS Fecha_Pago,
    DAY(Fecha) AS Dia,
    MONTH(Fecha) AS Mes,
    YEAR(Fecha) AS Anio,

    CASE
        WHEN Es_Festiva = 1 THEN 'SI'
        ELSE 'NO'
    END AS Fecha_Festiva,

    CASE
        WHEN Nombre_Festiva IS NOT NULL THEN Nombre_Festiva
        ELSE 'NINGUNA'
    END AS Nombre_Fecha_Festiva,

    CASE
        WHEN Es_Campania = 1 THEN 'SI'
        ELSE 'NO'
    END AS Fecha_Campania,

    CASE
        WHEN Nombre_Campania IS NOT NULL THEN Nombre_Campania
        ELSE 'NINGUNA'
    END AS Nombre_Campania

FROM
(
    SELECT
        CAST(fecha_venta AS DATE) AS Fecha,

        MAX(
            CASE
                WHEN observacion IN ('Semana Santa', 'Día de la Madre', 'Fiestas Patrias')
                THEN 1
                ELSE 0
            END
        ) AS Es_Festiva,

        MAX(
            CASE
                WHEN observacion IN ('Semana Santa', 'Día de la Madre', 'Fiestas Patrias')
                THEN observacion
                ELSE NULL
            END
        ) AS Nombre_Festiva,

        MAX(
            CASE
                WHEN observacion IN ('Feria Local', 'Pedido Mayorista')
                THEN 1
                ELSE 0
            END
        ) AS Es_Campania,

        MAX(
            CASE
                WHEN observacion IN ('Feria Local', 'Pedido Mayorista')
                THEN observacion
                ELSE NULL
            END
        ) AS Nombre_Campania

    FROM ventas

    GROUP BY CAST(fecha_venta AS DATE)

) AS Fechas;</property>
