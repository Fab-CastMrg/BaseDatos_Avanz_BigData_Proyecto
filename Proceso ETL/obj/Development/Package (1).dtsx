                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH MedioPago AS
(
    SELECT
        ROW_NUMBER() OVER (ORDER BY metodo_pago) AS Id_Medio_Pago,
        metodo_pago
    FROM pagos
    WHERE metodo_pago IS NOT NULL
    GROUP BY metodo_pago
),
TipoVenta AS
(
    SELECT
        ROW_NUMBER() OVER (ORDER BY observacion) AS Id_Tipo_Venta,
        observacion
    FROM ventas
    WHERE observacion IS NOT NULL
    GROUP BY observacion
),
TiempoMap AS
(
    SELECT
        ROW_NUMBER() OVER (ORDER BY Fecha) AS Id_Tiempo,
        Fecha
    FROM
    (
        SELECT DISTINCT
            CAST(fecha_venta AS DATE) AS Fecha
        FROM ventas
    ) AS Fechas
)

SELECT
    p.id_pago AS Id_Pago_Cliente,

    mp.Id_Medio_Pago,

    COALESCE(v.id_cliente, pe.id_cliente) AS Id_Cliente,

    t.Id_Tiempo,

    tv.Id_Tipo_Venta,

    p.monto AS Monto,

    DATEDIFF(
        DAY,
        CAST(COALESCE(v.fecha_venta, pe.fecha_pedido) AS DATE),
        CAST(p.fecha_pago AS DATE)
    ) AS Dias_Hasta_Pago

FROM pagos p

LEFT JOIN ventas v
    ON p.id_venta = v.id_venta

LEFT JOIN pedidos pe
    ON p.id_pedido = pe.id_pedido

LEFT JOIN MedioPago mp
    ON p.metodo_pago = mp.metodo_pago

LEFT JOIN TiempoMap t
    ON CAST(p.fecha_pago AS DATE) = t.Fecha

LEFT JOIN TipoVenta tv
    ON p.observacion = tv.observacion;</property>
