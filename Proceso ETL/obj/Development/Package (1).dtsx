                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH TiempoMap AS
(
    SELECT
        ROW_NUMBER() OVER (ORDER BY Fecha) AS Id_Tiempo,
        Fecha
    FROM
    (
        SELECT DISTINCT
            CAST(fecha_venta AS DATE) AS Fecha
        FROM ventas
    ) AS Fechas
)

SELECT
    e.id_egreso AS Id_Porcentaje_Gasto,

    e.id_tipo_movimiento AS Id_Egresos,

    t.Id_Tiempo,

    e.id_compra AS Id_Compras_Materia_Prima,

    ISNULL(c.total, 0) AS Total_Compras,

    ISNULL(c.subtotal, 0) AS Costo_Total_Insumos,

    e.monto AS Egreso_Total

FROM egresos e

LEFT JOIN compras c
    ON e.id_compra = c.id_compra

LEFT JOIN TiempoMap t
    ON CAST(e.fecha_egreso AS DATE) = t.Fecha;</property>
