    <DTS:Executable
      DTS:refId="Package\Poblar Control_Inventario"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{EC0276FC-D268-449B-AB66-112739540DCC}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Poblar Control_Inventario"
      DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\Poblar Control_Inventario\Insertar Tabla Control_Inventario"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Insertar Tabla Control_Inventario"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH TiempoMap AS
(
    SELECT
        ROW_NUMBER() OVER (ORDER BY Fecha) AS Id_Tiempo,
        Fecha
    FROM
    (
        SELECT DISTINCT
            CAST(fecha_venta AS DATE) AS Fecha
        FROM ventas
    ) AS Fechas
),
VentasProducto AS
(
    SELECT
        dv.id_producto,
        CAST(v.fecha_venta AS DATE) AS Fecha,
        SUM(dv.cantidad) AS Cantidad_Vendida
    FROM detalle_venta dv
    INNER JOIN ventas v
        ON dv.id_venta = v.id_venta
    GROUP BY
        dv.id_producto,
        CAST(v.fecha_venta AS DATE)
)

SELECT
    i.id_inventario AS Id_Control_Inventario,

    i.id_producto AS Id_Producto,

    t.Id_Tiempo,

    NULL AS Id_Venta,

    i.id_lote AS Id_Inventario,

    i.id_punto AS Id_Sede_Almacen,

    CAST(i.cantidad AS INT) AS Cantidad_Inventario,

    CAST(i.cantidad * p.precio_venta AS DECIMAL(12,2))
        AS Valor_Monetario_Inventario,

    DATEDIFF(
        DAY,
        CAST(i.fecha_actualizacion AS DATE),
        l.fecha_vencimiento
    ) AS Dias_Para_Vencer,

    CAST(ISNULL(vp.Cantidad_Vendida, 0) AS INT)
        AS Cantidad_Vendida

FROM inventario i

INNER JOIN productos p
    ON i.id_producto = p.id_producto

INNER JOIN lotes l
    ON i.id_lote = l.id_lote

LEFT JOIN TiempoMap t
    ON CAST(i.fecha_actualizacion AS DATE) = t.Fecha

LEFT JOIN VentasProducto vp
    ON i.id_producto = vp.id_producto
    AND CAST(i.fecha_actualizacion AS DATE) = vp.Fecha;</property>
