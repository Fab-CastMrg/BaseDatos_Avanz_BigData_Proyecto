<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<connectionStrings>
		<!-- Cambia Server si tu instancia tiene otro nombre (ver el nombre que usas en SSMS) -->
		<add name="ShiliquitaDB"
			 connectionString="Server=QUABI\SQLEXPRESS;Database=ChocolateriaLaShiliquita;Integrated Security=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<!-- Tasa del IGV (18%) y si los precios registrados ya incluyen IGV -->
		<add key="IgvTasa" value="0.18" />
		<add key="PreciosIncluyenIgv" value="true" />
	</appSettings>
</configuration>